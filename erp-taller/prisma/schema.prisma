generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../docs/03_arquitectura/modelo_db.svg"
  theme    = "light"
  includeRelationFromFields = true // <-- Intentamos forzar a que el SVG muestre las FKs
}

datasource db {
  provider = "postgresql"
}

enum CategoriaProducto {
  AUTOPARTE
  MOTOR
}

enum EstadoCotizacion {
  PENDIENTE
  VENDIDA
  ANULADA
}

// ==========================================
// MÓDULO DE SEGURIDAD Y PERMISOS INDEPENDIENTES
// ==========================================

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique // Ej. "DUEÑO", "VENDEDOR"
  descripcion String?
  is_active   Boolean      @default(true)
  
  usuarios    Usuario[]
  permisos_base RolPermisoBase[] // Solo sirve como plantilla inicial
}

model Permiso {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique // Ej. "CREAR_VENTA", "ELIMINAR_PRODUCTO"
  descripcion String?
  
  roles_base  RolPermisoBase[]
  usuarios    UsuarioPermiso[]
}

// Tabla intermedia para saber qué permisos sugerir según el Rol
model RolPermisoBase {
  rol_id      Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  permiso_id  Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  
  rol         Rol          @relation(fields: [rol_id], references: [id])
  permiso     Permiso      @relation(fields: [permiso_id], references: [id])
  
  @@id([rol_id, permiso_id])
}

// TABLA CRÍTICA: Aquí residen los permisos reales de cada usuario de forma independiente
model UsuarioPermiso {
  usuario_id  Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  permiso_id  Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  
  usuario     Usuario      @relation(fields: [usuario_id], references: [id])
  permiso     Permiso      @relation(fields: [permiso_id], references: [id])
  
  @@id([usuario_id, permiso_id])
}

model Usuario {
  id              Int              @id @default(autoincrement())
  nombre          String
  email           String           @unique
  password_hash   String
  salt            String           
  acceso_sistema  Boolean          @default(true) 
  is_active       Boolean          @default(true) 
  
  rol_id          Int // <-- LLAVE FORÁNEA REAL EN POSTGRES (Cada usuario TIENE un rol)
  rol             Rol              @relation(fields: [rol_id], references: [id])
  
  permisos        UsuarioPermiso[] // Sus permisos independientes
  cotizaciones    Cotizacion[]
  ventas          Venta[]
  gastos          Gasto[]
}

// ==========================================
// MÓDULO DE CLIENTES Y PRODUCTOS
// ==========================================

model Cliente {
  id              Int          @id @default(autoincrement())
  documento       String       @unique
  nombre          String
  telefono        String?
  direccion       String?
  
  cotizaciones    Cotizacion[]
}

model Producto {
  id              Int                 @id @default(autoincrement())
  nombre          String
  categoria       CategoriaProducto
  precio_base     Decimal             @db.Decimal(10, 2)
  stock           Int                 @default(0)
  detalles        Json      
  is_active       Boolean             @default(true) 
  
  detalles_cot    CotizacionDetalle[]
}

// ==========================================
// MÓDULO DE COTIZACIONES Y VENTAS
// ==========================================

model Cotizacion {
  id              Int               @id @default(autoincrement())
  estado          EstadoCotizacion  @default(PENDIENTE)
  descripcion     String?           
  total           Decimal           @db.Decimal(10, 2)
  fecha_creacion  DateTime          @default(now())
  
  cliente_id      Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  cliente         Cliente           @relation(fields: [cliente_id], references: [id])
  vendedor_id     Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  vendedor        Usuario           @relation(fields: [vendedor_id], references: [id])
  
  items           CotizacionDetalle[]
  venta           Venta?            
}

model CotizacionDetalle {
  id                Int         @id @default(autoincrement())
  cantidad          Int
  producto_nombre   String      // Snapshot
  precio_unitario   Decimal     @db.Decimal(10, 2) // Snapshot
  subtotal          Decimal     @db.Decimal(10, 2)
  
  cotizacion_id     Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  cotizacion        Cotizacion  @relation(fields: [cotizacion_id], references: [id])
  
  producto_id       Int? // <-- LLAVE FORÁNEA REAL EN POSTGRES (Opcional por si se borra el producto físico)
  producto          Producto?   @relation(fields: [producto_id], references: [id])
}

model Venta {
  id              Int         @id @default(autoincrement())
  descripcion     String?     
  metodo_pago     String      
  total_final     Decimal     @db.Decimal(10, 2)
  fecha_venta     DateTime    @default(now())
  
  cotizacion_id   Int         @unique // <-- LLAVE FORÁNEA REAL EN POSTGRES (1 a 1)
  cotizacion      Cotizacion  @relation(fields: [cotizacion_id], references: [id])
  vendedor_id     Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  vendedor        Usuario     @relation(fields: [vendedor_id], references: [id])
}

model Gasto {
  id              Int       @id @default(autoincrement())
  motivo          String
  monto           Decimal   @db.Decimal(10, 2)
  fecha           DateTime  @default(now())
  is_active       Boolean   @default(true)
  
  usuario_id      Int // <-- LLAVE FORÁNEA REAL EN POSTGRES
  usuario         Usuario   @relation(fields: [usuario_id], references: [id])
}