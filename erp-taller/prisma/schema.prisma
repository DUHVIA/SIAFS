// === CONFIGURACIÓN GENERAL Y GENERADORES ===

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "../../docs/03_arquitectura/modelo_db_v2.svg"
  theme                     = "light"
  includeRelationFromFields = true // <-- Intentamos forzar a que el SVG muestre las FKs
}

datasource db {
  provider = "postgresql"
}

// === ENUMS DEL SISTEMA ===

enum RolUsuario {
  DUEÑO
  ADMIN
  VENDEDOR
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  YAPE_PLIN
}

enum CategoriaProducto {
  AUTOPARTE
  MOTOR
}

enum EstadoCotizacion {
  PENDIENTE
  VENDIDA
  ANULADA
}

// === MODELOS DE ENTIDAD ===

model Usuario {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  rol           RolUsuario
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relaciones
  historicosPrecios HistoricoPrecios[]
  cotizaciones      Cotizacion[]
  ventas            Venta[]
  gastosInternos    GastoInterno[]

  @@map("usuarios")
}

model Cliente {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreCifrado    String   @map("nombre_cifrado") @db.Text
  idxNombre        String?  @map("idx_nombre") @db.VarChar(64)
  documentoCifrado String   @map("documento_cifrado") @db.Text
  idxDocumento     String   @unique @map("idx_documento") @db.VarChar(64)
  telefonoCifrado  String?  @map("telefono_cifrado") @db.Text
  correoCifrado    String?  @map("correo_cifrado") @db.Text
  direccionCifrado String?  @map("direccion_cifrado") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  // Relaciones
  cotizaciones Cotizacion[]
  ventas       Venta[]

  @@map("clientes")
}

model TipoAutoparte {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)

  @@map("tipos_autoparte")
}

model Producto {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreCifrado       String            @map("nombre_cifrado") @db.Text
  idxNombre           String?           @map("idx_nombre") @db.VarChar(64)
  categoria           CategoriaProducto
  precioVentaCifrado  String            @map("precio_venta_cifrado") @db.Text
  stockCifrado        String            @map("stock_cifrado") @db.Text
  rangoStock          Int               @default(0) @map("rango_stock")
  detallesCifrados    String            @map("detalles_cifrados") @db.Text
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")

  // Relaciones
  historicosPrecios   HistoricoPrecios[]
  detalleCotizaciones DetalleCotizacion[]
  detalleVentas       DetalleVenta[]

  @@map("productos")
}

model HistoricoPrecios {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId              String   @map("producto_id") @db.Uuid
  precioCompraCifrado     String   @map("precio_compra_cifrado") @db.Text
  cantidadIngresadaCifrada String   @map("cantidad_ingresada_cifrada") @db.Text
  fechaIngreso            DateTime @default(now()) @map("fecha_ingreso")
  usuarioId               String   @map("usuario_id") @db.Uuid

  // Relaciones FK explícitas
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("historico_precios")
}

model Cotizacion {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId    String           @map("cliente_id") @db.Uuid
  usuarioId    String           @map("usuario_id") @db.Uuid
  estado       EstadoCotizacion @default(PENDIENTE)
  subtotalCifrado String        @map("subtotal_cifrado") @db.Text
  totalCifrado String           @map("total_cifrado") @db.Text
  fechaValidez DateTime?        @map("fecha_validez")
  createdAt    DateTime         @default(now()) @map("created_at")

  // Relaciones FK explícitas
  cliente Cliente @relation(fields: [clienteId], references: [id])
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // Relaciones inversas
  detalleCotizaciones DetalleCotizacion[]
  venta               Venta?

  @@map("cotizaciones")
}

model DetalleCotizacion {
  id                            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotizacionId                  String @map("cotizacion_id") @db.Uuid
  productoId                    String @map("producto_id") @db.Uuid
  cantidadCifrada               String @map("cantidad_cifrada") @db.Text
  precioUnitarioCongeladoCifrado String @map("precio_unitario_congelado_cifrado") @db.Text

  // Relaciones FK explícitas
  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   Producto   @relation(fields: [productoId], references: [id])

  @@map("detalle_cotizaciones")
}

model Venta {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotizacionId String?    @unique @map("cotizacion_id") @db.Uuid
  clienteId    String     @map("cliente_id") @db.Uuid
  usuarioId    String     @map("usuario_id") @db.Uuid
  metodoPago   MetodoPago @map("metodo_pago")
  totalCifrado String     @map("total_cifrado") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  // Relaciones FK explícitas
  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id])
  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  usuario    Usuario     @relation(fields: [usuarioId], references: [id])

  // Relaciones inversas
  detalleVentas DetalleVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ventaId             String @map("venta_id") @db.Uuid
  productoId          String @map("producto_id") @db.Uuid
  cantidadCifrada     String @map("cantidad_cifrada") @db.Text
  precioUnitarioCifrado String @map("precio_unitario_cifrado") @db.Text

  // Relaciones FK explícitas
  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

model GastoInterno {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  motivoCifrado String   @map("motivo_cifrado") @db.Text
  montoCifrado  String   @map("monto_cifrado") @db.Text
  fecha         DateTime @db.Date
  usuarioId     String   @map("usuario_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relaciones FK explícitas
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("gastos_internos")
}