# URL de la base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@servidor:puerto/nombre_db"

# Clave secreta para firmar los JSON Web Tokens (Reemplazar con una cadena larga y segura en producción)
JWT_SECRET="reemplaza_esto_por_una_clave_larga_y_segura_en_produccion"

# Contraseña temporal obligatoria para el script de inicialización de usuarios (create-users.ts)
DEFAULT_USER_PASSWORD="CambiaEsto123*"

# URL Pública de la Aplicación (Usada para generar links de invitación en scripts de CLI)
# En Railway, puedes definirla como tu dominio público
# NEXT_PUBLIC_APP_URL="https://tu-erp-en-railway.app"
